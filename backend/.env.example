# Copy to backend/.env and adjust. Never commit .env.

# --- Database (local docker-compose, or your RDS endpoint in AWS) ---
DATABASE_URL=postgresql+asyncpg://aurelia:aurelia@localhost:5432/aurelia
# DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@your-rds-endpoint:5432/aurelia

# --- API ---
# The default is "production" (fail closed). Set "development" locally.
ENVIRONMENT=development
# Comma-separated list of allowed browser origins
CORS_ORIGINS=http://localhost:5173,http://localhost:4173
# Key required in the X-Admin-Key header for GET /api/v1/inquiries
# Generate a strong random key, min 32 chars (e.g. `python -c "import secrets; print(secrets.token_urlsafe(48))"`)
ADMIN_API_KEY=
MIN_ADMIN_KEY_LENGTH=32
# Optional: comma-separated hostnames accepted by TrustedHostMiddleware
# ALLOWED_HOSTS=api.example.com
# Comma-separated proxy IPs/CIDRs whose X-Forwarded-For may be trusted
# (for example the Next.js server or your load balancer)
# TRUSTED_PROXIES=127.0.0.1
# Direct API rate limit for inquiry submissions (per client IP, per minute)
INQUIRY_RATE_LIMIT_PER_MINUTE=10
