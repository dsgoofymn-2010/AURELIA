# Copy to backend/.env and adjust. Never commit .env.

# --- Database (local docker-compose, or your RDS endpoint in AWS) ---
DATABASE_URL=postgresql+asyncpg://aurelia:aurelia@localhost:5432/aurelia
# DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@your-rds-endpoint:5432/aurelia

# --- API ---
ENVIRONMENT=development
# Comma-separated list of allowed browser origins
CORS_ORIGINS=http://localhost:5173,http://localhost:4173
# Key required in the X-Admin-Key header for GET /api/v1/inquiries (empty = endpoint locked)
ADMIN_API_KEY=dev-admin-key

# --- Amazon SES ---
SES_REGION=ap-south-1
# Must be a verified sender in SES (or a verified domain)
SES_FROM_ADDRESS=menefides@gmail.com
# Company inbox that receives inquiry notifications
NOTIFY_TO=menefides@gmail.com
# Set to false to skip sending entirely (e.g. local runs without AWS credentials)
EMAIL_ENABLED=true

# boto3 reads credentials from the environment directly:
# AWS_ACCESS_KEY_ID=AKIA...
# AWS_SECRET_ACCESS_KEY=...
# (In AWS, prefer an IAM task/instance role and leave these unset.)
