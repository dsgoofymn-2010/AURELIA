# Frontend (Vite) — copy to .env.local for local dev.
# On Vercel: Project → Settings → Environment Variables (Production + Preview).
# Only VITE_* vars are exposed to the browser. Never put secrets here.

# Base URL of the backend API (no trailing slash needed).
# Local:      http://localhost:8000/api/v1
# Production: https://<your-backend-host>/api/v1
VITE_API_URL=http://localhost:8000/api/v1
